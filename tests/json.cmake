execute_process(COMMAND "${TEST_PROGRAM}" --fixture-json OUTPUT_VARIABLE data RESULT_VARIABLE result ENCODING UTF-8)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "JSON fixture failed: ${result}")
endif()
string(JSON schema GET "${data}" schema_version)
string(JSON label GET "${data}" volumes 0 label)
string(JSON disks LENGTH "${data}" physical_disks)
string(JSON state GET "${data}" health_evidence 3 state)
string(JSON mountless LENGTH "${data}" volumes 1 mount_points)
if(NOT schema STREQUAL "1.0" OR NOT disks EQUAL 5 OR NOT state STREQUAL "unavailable" OR NOT mountless EQUAL 0 OR NOT label STREQUAL "資料 café 🧪")
  message(FATAL_ERROR "JSON structure or Unicode round trip failed")
endif()
